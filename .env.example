# Copy to .env. Nothing here is a real secret: the system starts with this file as it is.

# Postgres (docker compose starts it; the port is the one on your machine)
DB_PORT=5432
DATABASE_URL=postgresql://labeler:labeler@localhost:5432/labeler

# Model keys. Leave empty to start without live labeling.
ANTHROPIC_API_KEY=
# Optional: without it, the Haiku screen runs instead of Jev.
TYPESAFE_API_KEY=

# Optional: traces and eval experiments in LangSmith (a free account is enough).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=labeling-agent

# The API serves on this port of your machine.
API_PORT=8000

# Which agent config the worker runs (app/agent/configs.py). Empty: jev_sonnet, or haiku_sonnet
# without TYPESAFE_API_KEY. LLM_BACKEND=fake labels with phrase rules and no model calls (CI, demos).
AGENT_CONFIG=
LLM_BACKEND=real
WORKER_CONCURRENCY=4

# Demo bearer tokens, one per user (app/auth.py). Change them anywhere that is not your laptop.
DEMO_TOKEN_MARKETPLACE=demo-marketplace
DEMO_TOKEN_MARKETPLACE_B=demo-marketplace-b
DEMO_TOKEN_VIEWER=demo-viewer
DEMO_TOKEN_EDITOR=demo-editor
DEMO_TOKEN_PUBLISHER_A=demo-publisher-a
DEMO_TOKEN_PUBLISHER_B=demo-publisher-b
